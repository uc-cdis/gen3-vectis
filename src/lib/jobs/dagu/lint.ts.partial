/**
 * Lint of a NATIVE Dagu definition, run at catalog load (so a bad file never reaches the catalog) and again by the runner
 * before it submits (defence in depth: the text is re-checked with the environment of the server that sends it).
 *
 * This is a deny-by-default screen, NOT a proof: the catalog reviewers are the first barrier, this is the second, and the
 * Dagu server's own role/permissions and its host/container isolation are the third. A file is accepted only if every
 * top-level key, step key and `with` key is on a short allowlist and every step's executor is one the operator enabled.
 *
 * What it enforces (each has a test):
 *  - strict YAML (one document, no anchors/merge keys, <= 64KB), array `steps`, unique ids, known `depends`, no cycle
 *  - executor allowlist (DAGU_ALLOWED_EXECUTORS; default docker,http,mail,jq; command/shell/ssh/... only when listed)
 *  - docker steps: literal image that passes the shared image policy (src/lib/jobs/images.ts); no volumes/network/privileges
 *  - no host side effects outside the executors: no schedule, webhook, preconditions, stdout/stderr redirects, working_dir,
 *    dotenv, custom step types/actions, sub-DAG calls, remote actions, agents, harnesses, ssh/s3/redis blocks
 *  - no command substitution (backticks, $( ) in any field that is not a shell command of a shell step
 *  - credentials: the shared credential patterns, plus "a field named like a secret must be a ${reference}, not a literal"
 *  - the portal-owned labels `vectis.*` cannot be declared by a definition (they are stamped by the portal)
 *  - where user parameters may land: shell command text (charset-guarded at compile), http query/body/headers and the path
 *    part of a url whose host is literal, jq `args`/`data`, mail subject/message, docker `command`; never an image, a mail
 *    recipient, a file path, a jq filter, the host of a url
 *  - http urls: https, public host (the shared URL rules), or one operator-controlled ${SECRET} from `secrets:`/`env:`
 */
import { parseYamlStrict } from '../jobdef/yamlStrict';
import type { DagStepInfo } from '../jobdef/types';
import { imageAllowed } from '../images';
import { scanString } from '../jobdef/lint';
import { isHttpsUrl } from '../urls';

type Env = Record<string, string | undefined>;
type Obj = Record<string, unknown>;
const isObj = (v: unknown): v is Obj => typeof v === 'object' && v !== null && !Array.isArray(v);

const DEFAULT_EXECUTORS: readonly string[] = ['docker', 'http', 'mail', 'jq'];
const ALIASES: Record<string, string> = { shell: 'command', exec: 'command', container: 'docker', k8s: 'kubernetes' };
const canon = (s: string): string => ALIASES[s] ?? s;

/** DAGU_ALLOWED_EXECUTORS as a set of canonical families. Unset/blank = the default. Invalid entries are ignored (fewer allowed). */
export function allowedExecutors(env: Env = process.env): Set<string> {
  const raw = env.DAGU_ALLOWED_EXECUTORS;
  if (raw === undefined || raw.trim() === '') return new Set(DEFAULT_EXECUTORS);
  return new Set(raw.split(',').map((s) => s.trim().toLowerCase()).filter((s) => /^[a-z][a-z0-9_-]{0,31}$/.test(s)).map(canon));
}

const NAME = /^[A-Za-z0-9_-]{1,64}$/;
const MAX_STEPS = 64;
const TOP_KEYS = new Set(['name', 'description', 'type', 'labels', 'tags', 'params', 'env', 'consts', 'secrets', 'steps', 'timeout_sec', 'max_active_steps', 'container', 'group']);
const STEP_KEYS = new Set(['id', 'name', 'description', 'depends', 'action', 'with', 'run', 'command', 'script', 'exec', 'shell', 'shell_args', 'type', 'config', 'env', 'output', 'retry_policy', 'continue_on', 'timeout_sec', 'container']);
const SHELL_KEYS = ['run', 'command', 'script', 'exec'];
const WITH_KEYS: Record<string, ReadonlySet<string>> = {
  http: new Set(['method', 'url', 'timeout', 'headers', 'query', 'body', 'silent', 'json', 'format']),
  jq: new Set(['filter', 'data', 'input', 'args', 'raw']),
  mail: new Set(['to', 'from', 'subject', 'message']),
  docker: new Set(['image', 'command', 'platform', 'pull', 'auto_remove', 'working_dir']),
};
const CONTAINER_KEYS = new Set(['image', 'pull_policy', 'env', 'working_dir', 'platform']);
const ENV_DENY = /^(PATH|IFS|SHELL|HOME|USER|ENV|BASH_ENV|LD_[A-Z_]*|DYLD_[A-Z_]*|PYTHON[A-Z_]*|NODE_OPTIONS|DAGU_[A-Z_]*)$/i;
const SECRET_FIELD = /authorization|token|secret|passw|api[_-]?key|credential|private[_-]?key/i;
const REF = /\$\{[^}]*\}/;
const SUBST = /`|\$\(/;
const SECRET_PROVIDERS = new Set(['env']);
/** Server environment variables a `secrets:` key may never name, whatever the operator allowlist says. */
const SECRET_KEY_DENY = /^(DAGU_|AWS_|GITHUB_|JOBS_|TES_|NODE_|LD_|DYLD_|GOOGLE_|AZURE_|KUBERNETES_|NPM_|PYTHON)|^(PATH|HOME|SHELL|USER|IFS|ENV|BASH_ENV)$/i;
/** DAGU_ALLOWED_SECRET_KEYS: exact names or `PREFIX*`. Unset/blank = the single prefix VECTIS_JOB_. */
function secretKeyProblem(key: string, env: Env): string | null {
  if (SECRET_KEY_DENY.test(key)) return 'this server variable is never allowed as a secret source';
  const raw = (env.DAGU_ALLOWED_SECRET_KEYS ?? '').trim();
  const list = raw ? raw.split(',').map((x) => x.trim()).filter(Boolean) : ['VECTIS_JOB_*'];
  return list.some((e) => (e.endsWith('*') ? key.startsWith(e.slice(0, -1)) && e.length > 1 : key === e)) ? null : 'this key is not on the allowlist (DAGU_ALLOWED_SECRET_KEYS; default prefix VECTIS_JOB_)';
}
/** Dagu variables verified to exist in 2.19.1 (llms.txt / docs): usable as ${NAME} in non-shell fields. */
const DAGU_SPECIAL = new Set(['DAG_RUN_ARTIFACTS_DIR', 'DAG_RUN_WORK_DIR']);
const IMAGE_RE = /^(?:[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?(?::[0-9]{1,5})?\/)?[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*(?:\/[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*)*(?::[A-Za-z0-9_][A-Za-z0-9_.-]{0,127})?(?:@sha256:[0-9a-f]{64})?$/;
const LABEL_RE = /^[a-z0-9._-]+(=[a-z0-9._/-]*)?$/;
const SHELLS = new Set(['sh', 'bash', '/bin/sh', '/bin/bash']);
const SHELL_ARGS = new Set(['-e', '-u', '-eu', '-x']);
const JQ_ENV = /\$ENV\b|\benv\b/;

interface DagInfo { name: string | null; steps: DagStepInfo[]; declaredParams: string[]; /** the parsed document that was linted: what is sent to Dagu is re-serialised from THIS */ doc: Record<string, unknown> }
type DagLint = { ok: true; info: DagInfo } | { ok: false; errors: string[] };

/** The executor family of one step, or an error. `inContainer` = a DAG-level or step-level `container:` makes shell steps run in it. */
function familyOf(step: Obj, inContainer: boolean, errs: string[], at: string): { family: string; label: string } | null {
  const selectors: string[] = [];
  if (SHELL_KEYS.some((k) => step[k] !== undefined)) selectors.push('shell');
  if (step.action !== undefined) selectors.push('action');
  if (step.type !== undefined) selectors.push('type');
  if (selectors.length !== 1) { errs.push(`${at}: needs exactly one of run/command/script, action or type (found ${selectors.length})`); return null; }
  if (selectors[0] === 'shell') {
    const bad = SHELL_KEYS.filter((k) => step[k] !== undefined);
    if (bad.length > 1) { errs.push(`${at}: use only one of run/command/script/exec`); return null; }
    return inContainer ? { family: 'docker', label: 'docker' } : { family: 'command', label: 'command' };
  }
  const word = selectors[0] === 'action' ? step.action : step.type;
  if (typeof word !== 'string' || !/^[A-Za-z0-9._/@:-]{1,100}$/.test(word)) { errs.push(`${at}: the executor must be a plain name`); return null; }
  if (selectors[0] === 'type') return { family: canon(word.toLowerCase()), label: word.toLowerCase() };
  if (/^[a-z][a-z0-9_]*(\.[a-z0-9_]+)?$/.test(word)) return { family: canon(word.split('.')[0]), label: word };
  return { family: 'remote', label: 'remote-action' }; // owner/repo@ver, source:..., custom names: code the portal has not seen
}

// parseYamlStrict refuses data nested deeper than 20, so these limits (24) can never silently cut a scan
function* strings(v: unknown, path: string, depth = 0): Generator<[string, string]> {
  if (depth > 24) throw new Error('too deep');
  if (typeof v === 'string') yield [path, v];
  else if (Array.isArray(v)) for (let i = 0; i < v.length; i++) yield* strings(v[i], `${path}[${i}]`, depth + 1);
  else if (isObj(v)) for (const [k, x] of Object.entries(v)) { yield [`${path}.${k}`, k]; yield* strings(x, `${path}.${k}`, depth + 1); }
}

/** Names a native `params:` declares, in every form Dagu documents (string, list of strings/maps/rich entries, map, inline JSON schema). */
export function declaredParamNames(params: unknown): string[] {
  const out: string[] = [];
  const add = (n: unknown) => { if (typeof n === 'string' && /^[A-Za-z_][A-Za-z0-9_]{0,63}$/.test(n)) out.push(n); };
  if (typeof params === 'string') { for (const m of params.matchAll(/([A-Za-z_][A-Za-z0-9_]*)=/g)) add(m[1]); }
  else if (Array.isArray(params)) {
    for (const e of params) {
      if (typeof e === 'string') add(e.split('=')[0]);
      else if (isObj(e)) { if (typeof e.name === 'string' && Object.keys(e).length > 1) add(e.name); else Object.keys(e).forEach(add); }
    }
  } else if (isObj(params)) {
    if (params.type === 'object' && isObj(params.properties)) Object.keys(params.properties).forEach(add);
    else if (!('schema' in params)) Object.keys(params).forEach(add);
  }
  return out;
}

const refsParam = (s: string, names: string[]): boolean => names.some((n) => new RegExp(`\\$\\{?\\s*(params\\.)?${n}\\b`).test(s));

/** Which step fields may carry a user parameter. Path is relative to the step ('with.query.value', 'run'). */
function paramAllowed(family: string, rel: string): boolean {
  if (rel.startsWith('env.')) return true;
  if (family === 'command') return /^(run|command|script|exec)(\[\d+\])?$/.test(rel);
  if (family === 'docker') return /^(with\.command(\[\d+\])?|run(\[\d+\])?|command(\[\d+\])?|script)$/.test(rel);
  if (family === 'http') return /^with\.(query|body|headers)(\.|$)/.test(rel) || rel === 'with.url';
  if (family === 'jq') return /^with\.(args|data)(\.|$|\[)/.test(rel);
  if (family === 'mail') return rel === 'with.subject' || rel === 'with.message';
  return false;
}

function lintHttpUrl(url: unknown, names: string[], secretNames: Set<string>, env: Env, errs: string[], at: string): void {
  if (typeof url !== 'string') { errs.push(`${at}: url must be text`); return; }
  // a whole-variable url may come ONLY from a declared secrets: name (operator-controlled); never env/consts literals, step outputs or parameters
  const whole = /^\$\{(?:secrets\.)?([A-Za-z_][A-Za-z0-9_]*)\}$/.exec(url);
  if (whole) { if (!secretNames.has(whole[1])) errs.push(`${at}: \${${whole[1]}} must be a name declared under secrets: (a url may not come from env, consts, a step output or a parameter)`); return; }
  const m = /^(https:\/\/[^/?#$]+)([\s\S]*)$/.exec(url);
  if (!m) { errs.push(`${at}: url must be https://host/... with a literal host, or one \${SECRET} declared under secrets:`); return; }
  if (REF.test(m[1]) || !isHttpsUrl(m[1], env)) { errs.push(`${at}: the url host is not allowed (https only, public host, TES_ALLOWED_URL_HOSTS)`); return; }
  const tail = m[2];
  // nothing may touch the host: after it the url continues with / ? or # (so no port/userinfo/suffix games), and parameters only live after that
  if (tail !== '' && !/^[/?#]/.test(tail)) { errs.push(`${at}: after the host the url must continue with /, ? or # (a parameter or other text may not be attached to the host)`); return; }
  const stripped = names.length ? tail.replace(new RegExp(`\\$\\{\\s*(?:params\\.)?(?:${names.join('|')})\\s*\\}|\\$(?:${names.join('|')})\\b`, 'g'), 'x') : tail;
  if (stripped.includes('$')) errs.push(`${at}: only a user parameter may be used inside a url (no other variable, no step output)`);
  if (/[\s\\]/.test(stripped)) errs.push(`${at}: the url contains whitespace or a backslash`);
  if (/(^|\/)\.\.(\/|$|\?|#)/.test(stripped)) errs.push(`${at}: the url path may not contain ".." segments`);
  if (!isHttpsUrl(m[1] + stripped, env)) errs.push(`${at}: the url (with parameters replaced) is not an allowed https url`);
}

/** Lint a native Dagu definition. `catalogParams` = the param names the catalog entry exposes (each must be declared natively). */
export function lintDaguDefinition(text: unknown, opts: { env?: Env; catalogParams?: readonly string[]; fallbackName?: string } = {}): DagLint {
  try { return lintInner(text, opts); } catch { return { ok: false, errors: ['definition is too deeply nested to check'] }; } // fail closed, never a partial scan
}
/** State shared by the phases of one lint. A phase only appends to `errs` and fills these sets; the order of the phases is the order of the messages. */
interface Ctx {
  env: Env; errs: string[]; doc: Obj; catalogParams: readonly string[];
  /** names the native `params:` declares */ declared: string[];
  /** names an operator controls: secrets:, env: and consts: */ operatorVars: Set<string>;
  secretNames: Set<string>; outputNames: Set<string>;
  dagContainer: boolean; steps: Obj[]; keys: Set<string>; stepFamily: string[]; infos: DagStepInfo[];
}

/** `env:` / `consts:` in the map or the list form, as [name, value] pairs. */
function envList(c: Ctx, v: unknown): Array<[string, unknown]> {
  const { errs } = c;
  if (v === undefined) return [];
  const entries: Array<[string, unknown]> = [];
  const addMap = (o: Obj) => { for (const [k, x] of Object.entries(o)) entries.push([k, x]); };
  if (isObj(v)) addMap(v);
  else if (Array.isArray(v)) for (const e of v) { if (isObj(e)) addMap(e); else if (typeof e === 'string' && e.includes('=')) entries.push([e.split('=')[0], e.slice(e.indexOf('=') + 1)]); else errs.push('env: unreadable entry'); }
  else errs.push('env: must be a map or list');
  return entries;
}

function checkEnv(c: Ctx, v: unknown, at: string): void {
  const { errs } = c;
  for (const [k, x] of envList(c, v)) {
    if (!/^[A-Za-z_][A-Za-z0-9_]{0,63}$/.test(k)) { errs.push(`${at}.${k.slice(0, 30)}: invalid variable name`); continue; }
    if (ENV_DENY.test(k)) errs.push(`${at}.${k}: this variable may not be set by a definition`);
    if (typeof x !== 'string' && typeof x !== 'number' && typeof x !== 'boolean') errs.push(`${at}.${k}: must be a plain value`);
  }
}

function checkImage(c: Ctx, image: unknown, at: string): void {
  const { errs, env } = c;
  if (typeof image !== 'string' || image.length === 0 || image.length > 512 || REF.test(image) || image.includes('..') || !IMAGE_RE.test(image)) { errs.push(`${at}: needs a literal image reference (no \${...})`); return; }
  const ok = imageAllowed(image, env);
  if (ok === 'not-configured') errs.push(`${at}: container steps are not enabled on this deployment (set JOBS_ALLOWED_IMAGE_PREFIXES)`);
  else if (!ok) errs.push(`${at}: this container image is not allowed`);
};
}

/** A DAG-level or step-level `container:`: a mapping with an image (a container name to exec into is not allowed). */
function imageFor(c: Ctx, container: unknown, at: string): void {
  const { errs } = c;
  if (!isObj(container)) { errs.push(`${at}: must be a mapping with an image (a container name to exec into is not allowed)`); return; }
  for (const k of Object.keys(container)) if (!CONTAINER_KEYS.has(k)) errs.push(`${at}.${k}: not allowed (allowed: ${[...CONTAINER_KEYS].join(', ')})`);
  checkImage(c, container.image, `${at}.image`);
  checkEnv(c, container.env, `${at}.env`);
}

function lintTopLevel(c: Ctx): void {
  const { doc, errs } = c;
  for (const k of Object.keys(doc)) if (!TOP_KEYS.has(k)) errs.push(`${k}: not allowed in a portal-managed definition (allowed: ${[...TOP_KEYS].join(', ')})`);
  if (doc.type !== undefined && doc.type !== 'graph' && doc.type !== 'chain') errs.push('type: only graph or chain');
  const name = doc.name === undefined ? null : doc.name;
  if (name !== null && (typeof name !== 'string' || !NAME.test(name))) errs.push('name: letters, digits, _ and - only (max 64)');
  if (typeof doc.description === 'string' && doc.description.length > 2048) errs.push('description: too long');
}

function lintLabels(c: Ctx): void {
  const { doc, errs } = c;
  // labels / tags: ASCII only (after NFKC + lower-case), list or map form, nothing in `vectis.` (portal-owned)
  for (const key of ['labels', 'tags'] as const) {
    const v = doc[key];
    if (v === undefined) continue;
    const norm = (x: string) => x.normalize('NFKC').toLowerCase();
    for (const [p, str] of strings(v, key)) if (norm(str).includes('vectis')) errs.push(`${p}: the vectis.* labels belong to the portal`);
    if (typeof v === 'string' || !(Array.isArray(v) || isObj(v))) { errs.push(`${key}: must be a list or a map (not text)`); continue; }
    const entries: string[] = [];
    const addPair = (k: string, x: unknown) => { if (typeof x === 'string' || typeof x === 'number' || typeof x === 'boolean') entries.push(`${k}=${String(x)}`); else errs.push(`${key}.${k.slice(0, 30)}: label values must be plain text`); };
    if (Array.isArray(v)) for (const e of v) { if (typeof e === 'string') entries.push(e); else if (isObj(e)) for (const [k, x] of Object.entries(e)) addPair(k, x); else errs.push(`${key}: unreadable entry`); }
    else for (const [k, x] of Object.entries(v)) addPair(k, x);
    for (const e of entries) {
      const n = norm(e);
      if (!LABEL_RE.test(n)) errs.push(`${key}: "${e.slice(0, 40)}" is not allowed (ASCII letters, digits . _ - and an optional =value only)`);
      else if (n.split('=')[0].startsWith('vectis.')) errs.push(`${key}: the vectis.* labels belong to the portal`);
    }
  }
}

function lintParams(c: Ctx): void {
  const { doc, errs } = c;
  // params: the external-schema form makes Dagu read a file or fetch a url; `eval` computes a default by running a command
  if (isObj(doc.params) && 'schema' in doc.params) errs.push('params: an external schema (file or url) is not allowed');
  const hasEval = (v: unknown, depth = 0): boolean => depth < 24 && (Array.isArray(v) ? v.some((x) => hasEval(x, depth + 1)) : isObj(v) ? Object.entries(v).some(([k, x]) => k === 'eval' || hasEval(x, depth + 1)) : false);
  if (hasEval(doc.params)) errs.push('params: `eval` (a default computed by running a command) is not allowed');
  c.declared = declaredParamNames(doc.params);
  for (const p of c.catalogParams) if (!c.declared.includes(p)) errs.push(`params: the catalog parameter "${p}" is not declared in the native params:`);
}

function lintSecrets(c: Ctx): void {
  const { doc, errs, env, operatorVars, secretNames } = c;
  // operator-controlled variables: secrets: names (env provider only) and literal env: names
  if (doc.secrets !== undefined) {
    if (!Array.isArray(doc.secrets) || doc.secrets.length > 32) errs.push('secrets: must be a list (max 32)');
    else doc.secrets.forEach((s, i) => {
      const at = `secrets[${i}]`;
      if (!isObj(s)) { errs.push(`${at}: must be a mapping`); return; }
      for (const k of Object.keys(s)) if (!['name', 'provider', 'key'].includes(k)) errs.push(`${at}.${k}: not allowed (only name, provider, key)`);
      if (typeof s.name !== 'string' || !/^[A-Z_][A-Z0-9_]{0,63}$/.test(s.name) || s.name.startsWith('DAGU_')) errs.push(`${at}.name: UPPER_CASE variable name, not DAGU_*`);
      else { operatorVars.add(s.name); secretNames.add(s.name); }
      if (typeof s.provider !== 'string' || !SECRET_PROVIDERS.has(s.provider)) errs.push(`${at}.provider: only ${[...SECRET_PROVIDERS].join(', ')}`);
      if (typeof s.key !== 'string' || !/^[A-Za-z_][A-Za-z0-9_]{0,63}$/.test(s.key)) errs.push(`${at}.key: a plain variable name`);
      else { const pr = secretKeyProblem(s.key, env); if (pr) errs.push(`${at}.key: ${pr}`); }
    });
}

function lintEnvAndConsts(c: Ctx): void {
  const { doc, errs, operatorVars } = c;
  checkEnv(c, doc.env, 'env');
  for (const [k] of envList(c, doc.env)) operatorVars.add(k);
  if (doc.consts !== undefined) { if (!Array.isArray(doc.consts) && !isObj(doc.consts)) errs.push('consts: must be a list of single-key maps'); else for (const [k] of envList(c, doc.consts)) operatorVars.add(k); }
}

function lintContainer(c: Ctx): void {
  const { doc, errs } = c;
  if (doc.container !== undefined) { c.dagContainer = true; imageFor(c, doc.container, 'container'); }
}

function collectSteps(c: Ctx): void {
  const { doc, errs, steps } = c;
  const steps: Obj[] = [];
  if (!Array.isArray(doc.steps) || doc.steps.length === 0) errs.push('steps: a non-empty list is required');
  else if (doc.steps.length > MAX_STEPS) errs.push(`steps: at most ${MAX_STEPS}`);
  else for (const s of doc.steps) { if (isObj(s)) steps.push(s); else errs.push('steps: every step must be a mapping'); }

}

/** The `with:`/`config:` block of a step: allowlisted keys per executor family, and where a user parameter may not land. */
function lintStepWith(c: Ctx, step: Obj, fam: { family: string; label: string }, at: string): void {
  const { errs, env, declared, secretNames } = c;
  const allowed = allowedExecutors(env);
  if (!allowed.has(fam.family)) errs.push(`${at}: the "${fam.family}" executor is not enabled (DAGU_ALLOWED_EXECUTORS=${[...allowed].join(',') || '(none)'})`);
  // `with` / `config`: allowlisted keys per family
  const withObj = step.with ?? step.config;
  if (withObj !== undefined && !isObj(withObj)) errs.push(`${at}.with: must be a mapping`);
  const wk = WITH_KEYS[fam.family];
  if (isObj(withObj)) {
    if (!wk) { if (Object.keys(withObj).length) errs.push(`${at}.with: not allowed for the "${fam.family}" executor`); }
    else for (const k of Object.keys(withObj)) if (!wk.has(k)) errs.push(`${at}.with.${k}: not allowed for the "${fam.family}" executor (allowed: ${[...wk].join(', ')})`);
  }
  if (step.with !== undefined && step.config !== undefined) errs.push(`${at}: use "with" or "config", not both`);
  if (fam.family === 'docker' && (step.action !== undefined || step.type !== undefined)) checkImage(c, isObj(withObj) ? withObj.image : undefined, `${at}.with.image`);
  if (fam.family === 'http' && isObj(withObj)) {
    lintHttpUrl(withObj.url, declared, secretNames, env, errs, `${at}.with.url`);
    if (typeof withObj.method === 'string' && !/^(GET|POST|PUT|PATCH|DELETE|HEAD)$/i.test(withObj.method)) errs.push(`${at}.with.method: not a plain HTTP method`);
  }
  if (fam.family === 'jq' && isObj(withObj) && typeof withObj.filter === 'string' && refsParam(withObj.filter, declared)) errs.push(`${at}.with.filter: a user parameter may not be part of the jq program (pass it with args)`);
  if (fam.family === 'mail' && isObj(withObj)) for (const f of ['to', 'from']) if (typeof withObj[f] === 'string' && REF.test(withObj[f] as string) && refsParam(withObj[f] as string, declared)) errs.push(`${at}.with.${f}: a user parameter may not choose a mail address`);
}

/** `shell` / `shell_args`: only on a command step, only sh or bash, only a few known flags, no free text. */
function lintStepShell(c: Ctx, step: Obj, family: string | undefined, at: string): void {
  const { errs } = c;
if (step.shell !== undefined || step.shell_args !== undefined) {
  if (family !== 'command') errs.push(`${at}: shell/shell_args only apply to a command step`);
  else {
    if (step.shell !== undefined && (typeof step.shell !== 'string' || !SHELLS.has(step.shell))) errs.push(`${at}.shell: only sh or bash (${[...SHELLS].join(', ')})`);
    if (step.shell_args !== undefined) {
      const a = step.shell_args;
      const list = Array.isArray(a) ? a : null;
      if (!list || !list.every((x) => typeof x === 'string' && SHELL_ARGS.has(x))) errs.push(`${at}.shell_args: a list drawn from ${[...SHELL_ARGS].join(' ')} only`);
      else if (step.shell === undefined) errs.push(`${at}.shell_args: needs shell`);
    }
  }
}
}

/** One step: its keys, id, executor, env, output name, shell settings and `depends`. */
function lintStep(c: Ctx, step: Obj, i: number): void {
  const { errs, dagContainer, keys, stepFamily, infos, outputNames, operatorVars, declared } = c;
  const at = `steps[${i}]`;
  for (const k of Object.keys(step)) if (!STEP_KEYS.has(k)) errs.push(`${at}.${k}: not allowed in a portal-managed definition`);
  const id = step.id, nm = step.name;
  if (id !== undefined && nm !== undefined && id !== nm) errs.push(`${at}: give a step an id OR a name, not two different ones`);
  const key = id ?? nm;
  if (typeof key !== 'string' || !NAME.test(key)) { errs.push(`${at}: needs an id of letters, digits, _ and - (max 64)`); }
  else if (keys.has(key)) errs.push(`${at}: duplicate step id "${key}"`);
  else keys.add(key);
  const inContainer = dagContainer || step.container !== undefined;
  if (step.container !== undefined) imageFor(c, step.container, `${at}.container`);
  const fam = familyOf(step, inContainer, errs, at);
  stepFamily.push(fam?.family ?? '');
  if (fam) lintStepWith(c, step, fam, at);
  checkEnv(c, step.env, `${at}.env`);
  for (const [ek] of envList(c, step.env)) operatorVars.add(ek);
  // output: NAME becomes an environment variable for later steps: same deny list as env
  if (typeof step.output === 'string') {
    if (!/^[A-Za-z_][A-Za-z0-9_]{0,63}$/.test(step.output) || ENV_DENY.test(step.output)) errs.push(`${at}.output: "${step.output.slice(0, 30)}" is not an allowed output variable name`);
    else outputNames.add(step.output);
  }
  lintStepShell(c, step, fam?.family, at);
  if (fam?.family === 'http' && isObj(step.with ?? step.config)) {
    const h = ((step.with ?? step.config) as Obj).headers;
    if (isObj(h)) for (const hk of Object.keys(h)) if (refsParam(hk, declared) || REF.test(hk) || /[^A-Za-z0-9-]/.test(hk)) errs.push(`${at}.with.headers: header name "${hk.slice(0, 30)}" must be a plain literal (no parameter, no reference)`);
  }
  const wf = isObj(step.with ?? step.config) ? ((step.with ?? step.config) as Obj).filter : undefined;
  if (fam?.family === 'jq' && typeof wf === 'string' && JQ_ENV.test(wf)) errs.push(`${at}.with.filter: a jq program may not read the environment ($ENV, env)`);
  const deps = step.depends;
  let depList: string[] = [];
  if (deps !== undefined) {
    if (typeof deps === 'string') depList = [deps];
    else if (Array.isArray(deps) && deps.every((d) => typeof d === 'string')) depList = deps as string[];
    else errs.push(`${at}.depends: must be a list of step ids`);
  }
  if (typeof key === 'string') infos.push({ name: key, depends_on: depList, executor: fam?.label ?? '' });
}
