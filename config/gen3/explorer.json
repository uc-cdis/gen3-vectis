[
  {
    "tabTitle": "WAF Requests",
    "filters": {
      "tabs": [
        {
          "title": "Request",
          "fields": [
            "rule_action",
            "http_method",
            "rule_id",
            "source"
          ],
          "fieldsConfig": {
            "rule_action": {
              "label": "Rule Action",
              "type": "enum",
              "description": "WAF terminating action for the request (ALLOW / BLOCK / COUNT)."
            },
            "http_method": {
              "label": "HTTP Method",
              "type": "enum",
              "description": "HTTP verb of the request."
            },
            "rule_id": {
              "label": "Matched Rule",
              "type": "enum",
              "description": "Terminating WAF rule that decided the request."
            },
            "source": {
              "label": "Log Source",
              "type": "enum",
              "description": "Ingest source that produced the record."
            }
          }
        }
      ]
    },
    "table": {
      "enabled": true,
      "fields": [
        "event_time",
        "http_method",
        "uri_path",
        "rule_action",
        "rule_id",
        "source"
      ],
      "columns": {
        "uri_path": {
          "sortable": true
        }
      },
      "pageLimit": {
        "limit": 10000
      }
    },
    "dropdowns": {},
    "buttons": [
      {
        "enabled": true,
        "type": "data-json",
        "title": "Export JSON",
        "leftIcon": "datafile",
        "rightIcon": "download",
        "actionArgs": {
          "filename": "waf_requests.json"
        }
      },
      {
        "enabled": true,
        "type": "data-csv",
        "title": "Export CSV",
        "leftIcon": "datafile",
        "rightIcon": "download",
        "actionArgs": {
          "filename": "waf_requests.csv"
        }
      },
      {
        "enabled": true,
        "type": "copy-filter-python",
        "title": "Copy as Python",
        "leftIcon": "datafile"
      }
    ],
    "loginForDownload": false,
    "guppyConfig": {
      "dataType": "http_activity",
      "nodeCountTitle": "WAF Requests",
      "fieldMapping": [
        {
          "field": "event_time",
          "name": "Time"
        },
        {
          "field": "http_method",
          "name": "Method"
        },
        {
          "field": "uri_path",
          "name": "URI"
        },
        {
          "field": "rule_action",
          "name": "Action"
        },
        {
          "field": "rule_id",
          "name": "Matched Rule"
        },
        {
          "field": "source",
          "name": "Log Source"
        },
        {
          "field": "host_header",
          "name": "Host"
        },
        {
          "field": "status_code",
          "name": "Status"
        },
        {
          "field": "country",
          "name": "Country"
        },
        {
          "field": "src_ip",
          "name": "Source IP"
        },
        {
          "field": "account_id",
          "name": "Account"
        }
      ],
      "manifestMapping": {},
      "accessibleFieldCheckList": [],
      "accessibleValidationField": ""
    }
  },
  {
