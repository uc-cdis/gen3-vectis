  {
    "tabTitle": "API Activity",
    "filters": {
      "tabs": [
        {
          "title": "Call",
          "fields": [
            "api_operation",
            "api_service",
            "outcome",
            "error_code",
            "region",
            "account_id",
            "is_read_only"
          ],
          "fieldsConfig": {
            "api_operation": {
              "label": "Operation",
              "type": "enum",
              "description": "API action invoked; this is the graph edge relating principal to resource."
            },
            "api_service": {
              "label": "Service",
              "type": "enum",
              "description": "Cloud service the call was made against."
            },
            "outcome": {
              "label": "Outcome",
              "type": "enum",
              "description": "Whether the call succeeded or was denied."
            },
            "error_code": {
              "label": "Error Code",
              "type": "enum",
              "description": "Error returned by the API, when the call failed."
            },
            "region": {
              "label": "Region",
              "type": "enum"
            },
            "account_id": {
              "label": "Account",
              "type": "enum"
            },
            "is_read_only": {
              "label": "Read-only",
              "type": "toggle",
              "description": "Read-only calls are usually reconnaissance; writes change state."
            }
          }
        }
      ]
    },
    "table": {
      "enabled": true,
      "fields": [
        "event_time",
        "api_operation",
        "api_service",
        "outcome",
        "error_code",
        "region",
        "account_id",
        "principal_arn"
      ],
      "columns": {
