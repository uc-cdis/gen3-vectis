        {
          "title": "Indicator",
          "fields": [
            "pattern_type",
            "indicator_types"
          ],
          "fieldsConfig": {
            "pattern_type": {
              "label": "Pattern Type",
              "type": "enum",
              "description": "STIX pattern dialect (typically 'stix')."
            },
            "indicator_types": {
              "label": "Indicator Type",
              "type": "multiselect",
              "description": "STIX indicator_types, e.g. malicious-activity."
            }
          }
        }
      ]
    },
    "table": {
