# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.idea

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.jupyterlite.doit.db

# JupyterLite output generated by `npm run build:jupyterlite` (the Dockerfiles run it; .dockerignore already excludes it)
/builds/

# Playwright output
/test-results/
/playwright-report/

# written by `next dev` (agent instruction stubs); not part of the portal
/AGENTS.md
/CLAUDE.md
